from abc import ABC, abstractmethod


#Часть 1: Иерархия транспорта

class Vehicle(ABC):
    __slots__ = ("_name",)

    def __init__(self, name: str) -> None:
        self._name = name

    @abstractmethod
    def describe(self) -> str:
        pass


class GroundVehicle(Vehicle):
    __slots__ = ()

    @abstractmethod
    def describe(self) -> str:
        pass


class WaterVehicle(Vehicle):
    __slots__ = ()

    @abstractmethod
    def describe(self) -> str:
        pass


class AirVehicle(Vehicle):
    __slots__ = ()

    @abstractmethod
    def describe(self) -> str:
        pass


#Часть 3: Двигатели (композиция)

class Engine(ABC):
    __slots__ = ()

    @abstractmethod
    def start(self) -> str:
        pass

    @abstractmethod
    def fuel_type(self) -> str:
        pass


class ElectricEngine(Engine):
    __slots__ = ()

    def start(self) -> str:
        return "Электродвигатель запущен"

    def fuel_type(self) -> str:
        return "электричество"


class DieselEngine(Engine):
    __slots__ = ()

    def start(self) -> str:
        return "Дизельный двигатель запущен"

    def fuel_type(self) -> str:
        return "дизель"


class HybridEngine(Engine):
    __slots__ = ()

    def start(self) -> str:
        return "Гибридный двигатель запущен"

    def fuel_type(self) -> str:
        return "гибрид (электро + дизель)"


#Конкретные транспортные средства

class Car(GroundVehicle):
    __slots__ = ("_engine",)

    def __init__(self, name: str, engine: Engine | None = None) -> None:
        super().__init__(name)
        if engine is not None:
            self._engine: Engine = engine
        else:
            self._engine: Engine = ElectricEngine()

    def describe(self) -> str:
        return f"Car '{self._name}' — наземный, двигатель: {self._engine.fuel_type()}"

    def replace_engine(self, engine: Engine) -> None:
        self._engine = engine

    def start(self) -> str:
        return self._engine.start()


class Boat(WaterVehicle):
    __slots__ = ("_engine",)

    def __init__(self, name: str, engine: Engine | None = None) -> None:
        super().__init__(name)
        if engine is not None:
            self._engine: Engine = engine
        else:
            self._engine: Engine = DieselEngine()

    def describe(self) -> str:
        return f"Boat '{self._name}' — водный, двигатель: {self._engine.fuel_type()}"

    def replace_engine(self, engine: Engine) -> None:
        self._engine = engine

    def start(self) -> str:
        return self._engine.start()


class Plane(AirVehicle):
    __slots__ = ("_engine",)

    def __init__(self, name: str, engine: Engine | None = None) -> None:
        super().__init__(name)
        if engine is not None:
            self._engine: Engine = engine
        else:
            self._engine: Engine = HybridEngine()

    def describe(self) -> str:
        return f"Plane '{self._name}' — воздушный, двигатель: {self._engine.fuel_type()}"

    def replace_engine(self, engine: Engine) -> None:
        self._engine = engine

    def start(self) -> str:
        return self._engine.start()


#Часть 4: Флот (агрегация)

class Fleet:
    __slots__ = ("_vehicles",)

    def __init__(self) -> None:
        self._vehicles: list[Vehicle] = []

    def add(self, vehicle: Vehicle) -> None:
        self._vehicles.append(vehicle)

    def print_all(self) -> list[str]:
        result = [v.describe() for v in self._vehicles]
        for line in result:
            print(line)
        return result


if __name__ == "__main__":
    car = Car("Toyota")
    boat = Boat("Титаник")
    plane = Plane("Победа")
    plane2 = Plane("Кукурузник", engine=DieselEngine())

    print("Старт двигателей:")
    print(car.start())
    print(boat.start())
    print(plane.start())
    print(plane2.start())

    print("\nЗамена двигателя у машины:")
    car.replace_engine(HybridEngine())
    print(car.start())
    print(car.describe())

    print("\nФлот:")
    fleet = Fleet()
    fleet.add(car)
    fleet.add(boat)
    fleet.add(plane)
    fleet.add(plane2)
    fleet.print_all()
