from enum import Enum, auto
from ftplib import FTP
from io import BytesIO, StringIO
from typing import List, Protocol


# уровни важности для логов
class LogLevel(Enum):
    INFO = auto()
    WARN = auto()
    ERROR = auto()


# интерфейс для фильтров
class ILogFilter(Protocol):
    def match(self, log_level: LogLevel, text: str) -> bool:
        ...


# интерфейс для обработчиков
class ILogHandler(Protocol):
    def handle(self, log_level: LogLevel, text: str) -> None:
        ...


# интерфейс для форматтеров
class ILogFormatter(Protocol):
    def format(self, log_level: LogLevel, text: str) -> str:
        ...


# фильтр по обычному тексту
class SimpleLogFilter:
    def __init__(self, pattern: str):
        self.pattern = pattern

    def match(self, log_level: LogLevel, text: str) -> bool:
        return self.pattern in text


# фильтр по регуляркам
class ReLogFilter:
    def __init__(self, pattern: str):
        self.pattern = re.compile(pattern)

    def match(self, log_level: LogLevel, text: str) -> bool:
        return bool(self.pattern.search(text))


# фильтр по уровню важности
class LevelFilter:
    def __init__(self, level: LogLevel):
        self.level = level

    def match(self, log_level: LogLevel, text: str) -> bool:
        return log_level == self.level


# добавляет дату и время
class DefaultFormatter:
    def format(self, log_level: LogLevel, text: str) -> str:
        dt = datetime.now().strftime("%Y.%m.%d %H:%M:%S")
        return f"[{log_level.name}] [{dt}] {text}"


# вывод логов на экран
class ConsoleHandler:
    def handle(self, log_level: LogLevel, text: str) -> None:
        print(text)


# запись логов в файл
class FileHandler:
    def __init__(self, filename: str):
        self.filename = filename

    def handle(self, log_level: LogLevel, text: str) -> None:
        with open(self.filename, 'a', encoding='utf-8') as f:
            f.write(text + '\n')


# отправка логов через сокет
class SocketHandler:
    def __init__(self, host: str, port: int):
        self.host = host
        self.port = port

    def handle(self, log_level: LogLevel, text: str) -> None:
        try:
            with socket.create_connection((self.host, self.port), timeout=1.0) as s:
                s.sendall((text + '\n').encode('utf-8'))
        except OSError as e:
            print(f"[SocketHandler] Не удалось отправить лог: {e}")


# запись в системный журнал
class SyslogHandler:
    _LEVEL_MAP = {
        LogLevel.INFO: logging.INFO,
        LogLevel.WARN: logging.WARNING,
        LogLevel.ERROR: logging.ERROR,
    }

    def __init__(self, facility: str = "user"):
        self._logger = logging.getLogger("syslog_handler")
        self._logger.setLevel(logging.DEBUG)
        self._logger.propagate = False
        if self._logger.handlers:
            return
        try:
            # нативный syslog (Unix)
            handler = logging.handlers.SysLogHandler(
                address="/dev/log", facility=facility
            )
            self._logger.addHandler(handler)
        except (OSError, AttributeError, FileNotFoundError):
            try:
                # fallback на UDP (Windows)
                handler = logging.handlers.SysLogHandler(
                    address=("localhost", 514), facility=facility
                )
                self._logger.addHandler(handler)
            except Exception:
                self._logger.addHandler(logging.NullHandler())

    def handle(self, log_level: LogLevel, text: str) -> None:
        self._logger.log(self._LEVEL_MAP[log_level], text)


# запись на FTP
class FtpHandler:
    def __init__(self, host: str, user: str, passwd: str, filename: str):
        self.host = host
        self.user = user
        self.passwd = passwd
        self.filename = filename
        self._buffer = StringIO()

    def handle(self, log_level: LogLevel, text: str) -> None:
        self._buffer.write(text + '\n')
        self._flush()

    def _flush(self) -> None:
        try:
            with FTP(self.host, timeout=2) as ftp:
                ftp.login(self.user, self.passwd)
                data = self._buffer.getvalue().encode('utf-8')
                ftp.storbinary(f"STOR {self.filename}", BytesIO(data))
            self._buffer = StringIO()  # очистка после успешной отправки
        except Exception as e:
            print(f"[FtpHandler] Не удалось выгрузить логи на FTP: {e}")

class Logger:
    def __init__(self, filters: List[ILogFilter], formatters: List[ILogFormatter], handlers: List[ILogHandler]):
        self.filters = filters
        self.formatters = formatters
        self.handlers = handlers

    def log(self, log_level: LogLevel, text: str) -> None:
        for f in self.filters:
            if not f.match(log_level, text):
                return

        formatted_text = text
        for fmt in self.formatters:
            formatted_text = fmt.format(log_level, formatted_text)

        for h in self.handlers:
            h.handle(log_level, formatted_text)

    def log_info(self, text: str) -> None:
        self.log(LogLevel.INFO, text)

    def log_warn(self, text: str) -> None:
        self.log(LogLevel.WARN, text)

    def log_error(self, text: str) -> None:
        self.log(LogLevel.ERROR, text)

