    received: list[str] = []

    def _socket_server():
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind(("127.0.0.1", 0))
        port = srv.getsockname()[1]
        srv.listen(1)
        received.append(str(port))
        srv.settimeout(3.0)
        try:
            conn, _ = srv.accept()
            with conn:
                received.append(conn.recv(4096).decode("utf-8").strip())
        except socket.timeout:
            pass
        finally:
            srv.close()

    t = threading.Thread(target=_socket_server, daemon=True)
    t.start()
    for _ in range(50):
        if received:
            break
        time.sleep(0.05)

