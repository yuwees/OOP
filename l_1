import math


class Angle:

    def __init__(self, radians):
        self._radians = radians % (2 * math.pi)

    @classmethod
    def from_radians(cls, radians):
        return cls(radians)

    @classmethod
    def from_degrees(cls, degrees):
        return cls(math.radians(degrees))

    def __str__(self):
        return f"Angle({self._radians:.4f})"

    def __repr__(self):
        return f"Angle.from_radians({self._radians})"

    def get_radians(self):
        return self._radians

    def set_radians(self, radians):
        self._radians = radians % (2 * math.pi)

    def get_degrees(self):
        return math.degrees(self._radians)

    def set_degrees(self, degrees):
        self._radians = math.radians(degrees) % (2 * math.pi)

    def __eq__(self, other):
        if isinstance(other, Angle):
            return math.isclose(self._radians, other._radians, abs_tol=1e-9)
        return NotImplemented

    def __lt__(self, other):
        if isinstance(other, Angle):
            return self._radians < other._radians
        return NotImplemented

    def __le__(self, other):
        if isinstance(other, Angle):
            return self._radians <= other._radians or self.__eq__(other)
        return NotImplemented

    def __gt__(self, other):
        if isinstance(other, Angle):
            return self._radians > other._radians
        return NotImplemented

    def __ge__(self, other):
        if isinstance(other, Angle):
            return self._radians >= other._radians or self.__eq__(other)
        return NotImplemented

    def __ne__(self, other):
        result = self.__eq__(other)
        if result is NotImplemented:
            return NotImplemented
        return not result

    def __float__(self):
        return float(self._radians)

    def __int__(self):
        return int(self._radians)

    def __add__(self, other):
        if isinstance(other, Angle):
            return Angle(self._radians + other._radians)
        elif isinstance(other, (int, float)):
            return Angle(self._radians + other)
        return NotImplemented

    def __sub__(self, other):
        if isinstance(other, Angle):
            return Angle(self._radians - other._radians)
        elif isinstance(other, (int, float)):
            return Angle(self._radians - other)
        return NotImplemented

    def __mul__(self, other):
        if isinstance(other, (int, float)):
            return Angle(self._radians * other)
        return NotImplemented

    def __truediv__(self, other):
        if isinstance(other, (int, float)):
            if other == 0:
                raise ZeroDivisionError
            return Angle(self._radians / other)
        return NotImplemented


class AngleRange:

    def __init__(self, start, end, include_start=True, include_end=True):
        if isinstance(start, Angle):
            self.start = start
        else:
            self.start = Angle.from_radians(float(start))
        if isinstance(end, Angle):
            self.end = end
        else:
            self.end = Angle.from_radians(float(end))

        self.include_start = include_start
        self.include_end = include_end

    def __str__(self):
        if self.include_start:
            left_bracket = "["
        else:
            left_bracket = "("
        if self.include_end:
            right_bracket = "]"
        else:
            right_bracket = ")"

        return f"{left_bracket}{self.start.get_degrees():.2f} , {self.end.get_degrees():.2f}{right_bracket}"

    def __repr__(self):
        return (f"AngleRange(start={repr(self.start)}, end={repr(self.end)}, "
                f"include_start={self.include_start}, include_end={self.include_end})")

    def __eq__(self, other):
        if isinstance(other, AngleRange):
            return (self.start == other.start and
                    self.end == other.end and
                    self.include_start == other.include_start and
                    self.include_end == other.include_end)
        return NotImplemented

    def __abs__(self):
        diff = self.end.get_radians() - self.start.get_radians()
        if diff < 0:
            diff += 2 * math.pi
        return Angle.from_radians(diff)

    def __lt__(self, other):
        if isinstance(other, AngleRange):
            return abs(self).get_radians() < abs(other).get_radians()
        return NotImplemented

    def __le__(self, other):
        if isinstance(other, AngleRange):
            return abs(self).get_radians() <= abs(other).get_radians()
        return NotImplemented

    def __gt__(self, other):
        if isinstance(other, AngleRange):
            return abs(self).get_radians() > abs(other).get_radians()
        return NotImplemented

    def __ge__(self, other):
        if isinstance(other, AngleRange):
            return abs(self).get_radians() >= abs(other).get_radians()
        return NotImplemented

    def __contains__(self, item):
        if isinstance(item, Angle):
            if self.start <= self.end:
                if self.include_start:
                    left_ok = (item >= self.start)
                else:
                    left_ok = (item > self.start)
                if self.include_end:
                    right_ok = (item <= self.end)
                else:
                    right_ok = (item < self.end)
                return left_ok and right_ok
            else:
                if self.include_start:
                    left_ok = (item >= self.start)
                else:
                    left_ok = (item > self.start)
                if self.include_end:
                    right_ok = (item <= self.end)
                else:
                    right_ok = (item < self.end)
                return left_ok or right_ok

        elif isinstance(item, AngleRange):
            return (item.start in self) and (item.end in self)
        return False

    def __add__(self, other):
        if isinstance(other, AngleRange):
