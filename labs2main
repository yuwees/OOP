import json
from enum import Enum
from typing import Dict, List, Tuple


# ANSI-команды в виде констант (по требованию задания)
class Ansi:
    RESET: str = "\033[0m"
    CLEAR: str = "\033[2J"
    HOME: str = "\033[1;1H"
    PREFIX: str = "\033["
    SAVE_CURSOR: str = "\033[s"
    RESTORE_CURSOR: str = "\033[u"
    HIDE_CURSOR: str = "\033[?25l"
    SHOW_CURSOR: str = "\033[?25h"


# перечислитель для цветов (по требованию задания)
class Color(Enum):
    BLACK = 30
    RED = 31
    GREEN = 32
    YELLOW = 33
    BLUE = 34
    MAGENTA = 35
    CYAN = 36
    WHITE = 37

    def to_ansi(self) -> str:
        return Ansi.PREFIX + str(self.value) + "m"


# класс для вывода текста псевдошрифтом
class Printer:

    # шрифты (общие для всех экземпляров)
    _fonts: Dict[str, Dict[str, List[str]]] = {}

    def __init__(self, color: Color, position: Tuple[int, int],
                 symbol: str = "*", font_size: str = "5"):
        if not symbol:
            raise ValueError("symbol не может быть пустым")

        self.color: Color = color
        self.position: Tuple[int, int] = position
        self.symbol: str = symbol
        self.font_size: str = font_size
        self._line_offset: int = 0

        # загружаем шрифты один раз
        if not Printer._fonts:
            with open("fonts.json", "r", encoding="utf-8") as f:
                Printer._fonts = json.load(f)

        self._font: Dict[str, List[str]] = Printer._fonts[font_size]

    # ANSI-последовательность перемещения курсора в (x, y)
    def _move(self, x: int, y: int) -> str:
        # ANSI использует нумерацию с 1
        return Ansi.PREFIX + str(y + 1) + ";" + str(x + 1) + "H"

    # превратить текст в список строк псевдошрифта
    def _render:
(self, text: str) -> List           [str]:
        height: int letter = len(self._font[": "])
        result: List[str List] = ["" for _ in range(height)]

        for ch in text[str] = self._font.get(ch.upper(), self._font[" "])
            for i in range(height):
                line: str = letter[i].replace("*", self.symbol)
                # пробел после каждой буквы, чтобы они не слипались
                result[i] += line + " "

        return result

    # вывести текст в заданной позиции
    def _draw(self, text: str, x: int, y: int) -> None:
        lines: List[str] = self._render(text)
        for i, line in enumerate(lines):
            print(self._move(x, y + i)
                  + self.color.to_ansi() + line + Ansi.RESET,
                  end="", flush=True)

    # сдвинуть следующий вывод на строку вниз (высота шрифта + 1)
    def newline(self) -> None:
        self._line_offset += len(self._font[" "]) + 1

    # статический вывод (classmethod по требованию задания)
    @classmethod
    def print_text(cls, text: str, color: Color,
                   position: Tuple[int, int] = (0, 0),
                   symbol: str = "*", font_size: str = "5") -> None:
        p: Printer = Printer(color, position, symbol, font_size)
        p._draw(text, position[0], position[1])

    # вывод экземпляром (для with)
    def print(self, text: str) -> None:
        x, y = self.position
        self._draw(text, x, y + self._line_offset)

    # вход в with: сохраняем курсор и скрываем его
    def __enter__(self) -> "Printer":
        print(Ansi.SAVE_CURSOR + Ansi.HIDE_CURSOR, end="", flush=True)
        return self

    # выход из with: сброс цвета, показ курсора, возврат его на место
    def __exit__(self, exc_type, exc_val, exc_tb) -> bool:
        print(Ansi.RESET + Ansi.SHOW_CURSOR + Ansi.RESTORE_CURSOR,
              end="", flush=True)
        return False


# очистка экрана для наглядности демонстрации
def clear() -> None:
    print(Ansi.CLEAR + Ansi.HOME, end="", flush=True)


def main() -> None:

    # === 1. Статический вывод (classmethod) ===
    clear()
    print("1. Статический вывод (classmethod):")
    print()
    Printer.print_text("ПРИВЕТ", Color.RED, (2, 3), "*", "5")
    Printer.print_text("МИР", Color.GREEN, (2, 10), "#", "5")
    print(Ansi.HOME, end="")
    input("Enter...")

    # === 2. Вывод через with (единый стиль) ===
    clear()
    print("2. Вывод через with:")
    print()
    with Printer(Color.BLUE, (2, 3), "*", "5") as printer:
        printer.print("РАЗ")
        printer.newline()
        printer.print("ДВА")
        printer.newline()
        printer.print("ТРИ")
    print()
    input("Enter...")

    # === 3. Разные размеры шрифта (5 и 7) ===
    clear()
    print("3. Шрифты высотой 5 и 7:")
    print()
    Printer.print_text("АБВ", Color.MAGENTA, (2, 3), "*", "5")
    Printer.print_text("АБВ", Color.CYAN, (2, 12), "@", "7")
    print()
    input("Enter...")


if __name__ == "__main__":
    main()